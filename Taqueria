<script>
let seleccionados=[];
let vendidos=JSON.parse(localStorage.getItem('bonos_huatabampo_vendidos')||"[]");
if(vendidos.length===0){vendidos=[{num:"07",nombre:"María G."},{num:"23",nombre:"Juan P."},{num:"45",nombre:"Lucy"}];localStorage.setItem('bonos_huatabampo_vendidos',JSON.stringify(vendidos));}
let filtro='todos';
function ver(s){document.querySelectorAll('.seccion').forEach(x=>x.classList.remove('activa'));document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('activo'));document.getElementById('sec-'+s).classList.add('activa');document.getElementById('tab-'+(s==='comprar'?'comprar':s==='premios'?'premios':'admin')).classList.add('activo');render();}
function filtrar(f,btn){filtro=f;document.querySelectorAll('.filtros button').forEach(b=>b.classList.remove('activo'));if(btn)btn.classList.add('activo');render();}
function render(){let grid=document.getElementById('gridNumeros');let html="";for(let i=0;i<100;i++){let num=i<10?"0"+i:""+i;let estaVendido=vendidos.find(v=>v.num===num);let estaSel=seleccionados.includes(num);if(filtro==='disponibles'&&estaVendido)continue;if(filtro==='mios'&&!estaSel)continue;let clase=estaVendido?"numero vendido":estaSel?"numero sel":"numero";html+=`<div class="${clase}" onclick="toggleNum('${num}')">${num}<br><small style="font-size:9px;font-weight:400">${estaVendido?estaVendido.nombre:estaSel?'TUYO':'$100'}</small></div>`;}grid.innerHTML=html;document.getElementById('vendidosText').innerText=vendidos.length+" / 100 vendidos";document.getElementById('barra').style.width=vendidos.length+"%";let lista=document.getElementById('listaSel');if(seleccionados.length===0)lista.innerHTML="No has elegido número todavía, jefe.";else lista.innerHTML=seleccionados.map(n=>`<span style="background:#FFD700;color:#111;padding:4px 10px;border-radius:100px;display:inline-block;margin:2px;font-weight:900">🎟️ ${n}</span>`).join(' ');document.getElementById('total').innerText="$"+(seleccionados.length*100);let htmlAdmin="";if(vendidos.length===0)htmlAdmin="<p style='color:#aaa'>No hay vendidos.</p>";vendidos.forEach(v=>{htmlAdmin+=`<div class="ganador"><span><b>#${v.num}</b> - ${v.nombre}</span><span class="badge" style="background:#FFD700;color:#111">$100</span></div>`;});document.getElementById('listaAdmin').innerHTML=htmlAdmin;document.getElementById('statVentas').innerText="$"+(vendidos.length*100);document.getElementById('statVendidos').innerText=vendidos.length+" números vendidos de 100";}
function toggleNum(num){let estaVendido=vendidos.find(v=>v.num===num);if(estaVendido)return alert('Ese número ya está vendido, jefe. Elige otro.');if(seleccionados.includes(num))seleccionados=seleccionados.filter(n=>n!==num);else seleccionados.push(num);render();}
function elegirAleatorio(){let disponibles=[];for(let i=0;i<100;i++){let num=i<10?"0"+i:""+i;if(!vendidos.find(v=>v.num===num)&&!seleccionados.includes(num))disponibles.push(num);}if(disponibles.length===0)return alert('Ya no hay números.');let ale=disponibles[Math.floor(Math.random()*disponibles.length)];seleccionados.push(ale);render();}
function apartar(){let nombre=document.getElementById('nombre').value.trim();let whats=document.getElementById('whats').value.trim();if(seleccionados.length===0)return alert('Elige un número primero, jefe.');if(!nombre)return alert('Pon tu nombre.');if(!whats)return alert('Pon tu WhatsApp.');seleccionados.forEach(num=>{vendidos.push({num,nombre});});localStorage.setItem('bonos_huatabampo_vendidos',JSON.stringify(vendidos));let nums=seleccionados.join(', ');seleccionados=[];render();alert('¡Listo! Apartaste #'+nums+'. Mándanos mensaje por WhatsApp para confirmar tu pago.');pedirWAConDatos(nombre,nums);}
function pedirWAConDatos(nombre,nums){let msg=`Hola Bonos Huatabampo, quiero apartar mis números: ${nums}\nNombre: ${nombre}\nTotal: $${nums.split(',').length*100}\nMétodo: ${document.getElementById('pago').value}`;window.open('https://wa.me/526471157123?text='+encodeURIComponent(msg),'_blank');}
function pedirWA(){if(seleccionados.length===0)return alert('Elige un número primero.');let nombre=document.getElementById('nombre').value.trim()||"";pedirWAConDatos(nombre,seleccionados.join(', '));}
function entrarAdmin(){if(document.getElementById('claveAdmin').value==='meza123'){document.getElementById('loginAdmin').style.display='none';document.getElementById('panelAdmin').style.display='block';render();}else alert('Clave incorrecta.');}
function marcarVendido(){let num=document.getElementById('numManual').value.trim().padStart(2,'0');let nom=document.getElementById('nombreManual').value.trim()||"Vendido";if(!num)return alert('Pon el número.');if(vendidos.find(v=>v.num===num))return alert('Ya está vendido.');vendidos.push({num,nombre:nom});localStorage.setItem('bonos_huatabampo_vendidos',JSON.stringify(vendidos));render();alert('Número #'+num+' marcado como vendido para '+nom);}
function liberarTodo(){if(confirm('¿Liberar todos?')){vendidos=[];localStorage.setItem('bonos_huatabampo_vendidos',JSON.stringify(vendidos));render();}}
let fin=new Date();fin.setDate(fin.getDate()+12);setInterval(()=>{let ahora=new Date();let diff=fin-ahora;if(diff<0)diff=0;document.getElementById('cd-d').innerText=Math.floor(diff/86400000);document.getElementById('cd-h').innerText=Math.floor(diff%86400000/3600000);document.getElementById('cd-m').innerText=Math.floor(diff%3600000/60000);document.getElementById('cd-s').innerText=Math.floor(diff%60000/1000);},1000);
render();
